*

# Keep the repo-level ignore file
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/pyproject.toml

# Publish only the flattened CPU source tree
!/src/
!/src/**/
!/src/*.py
!/src/*.csv
!/src/**/*.py
!/src/**/*.csv
!/src/old_architecture/V_ion/splineData.mat
!/src/old_architecture/README.md
!/src/old_architecture/native/CMakeLists.txt
!/src/old_architecture/native/pyproject.toml
!/src/old_architecture/native/*.cpp
!/src/old_architecture/native/*.h
!/src/new_architecture/**/*.md
!/src/new_architecture/requirements.txt
!/src/new_architecture/provenance/*.json
!/src/new_architecture/tests/data/*.DAT
!/src/new_architecture/tests/data/*.in
!/src/new_architecture/benchmarks/**/*.DAT
!/src/new_architecture/benchmarks/**/*.in
!/src/new_architecture/benchmarks/**/*reference.out
!/src/new_architecture/benchmarks/**/*python.out
!/src/new_architecture/benchmarks/**/*reference_time.txt

# Ignore generated Python artifacts anywhere
**/__pycache__/
**/*.py[cod]

# Local-only folders
/.cuda-shim/
/.cupy-cache/
/.mplconfig/
/.tmp/
/.venv/
/.venv312/
/parsec_python-cpu/
/parsec_python-gpu/
/samples/
!/samples/
!/samples/**
/.DS_Store
