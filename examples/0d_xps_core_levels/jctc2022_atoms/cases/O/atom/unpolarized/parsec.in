Boundary_Conditions: cluster
Cluster_Domain_Shape: sphere
Boundary_Sphere_Radius: 7 ang
Grid_Spacing: 0.1 ang
Expansion_Order: 8
Coordinate_Unit: Cartesian_Ang
Ignore_Symmetry: false

Atom_Types_Num: 1
Total_Atom_Num: 1

Atom_Type: O
Element_Symbol: O
Pseudopotential_Format: martins_new
Local_Component: p
Read_VCD: true
Cubic_Spline: true
begin Atom_Coord
 0.0 0.0 0.0
end Atom_Coord

Correlation_Type: pbe
Spin_Polarization: false
States_Num: 16
Net_Charges: 0 e
Fermi_Temp: -1 K
Max_Iter: 150
Convergence_Criterion: 1e-6 Ry

Eigensolver: chebff
Chebdav_Degree: 40
FF_MaxIter: 4
Matvec_Blocksize: 16
Chebyshev_Degree: 20
Chebyshev_Degree_Delta: 3
Subspace_Buffer_Size: 6
Diag_Tolerance: 1e-5

Mixing_Method: Anderson
Mixing_Param: 0.30
Memory_Param: 4
Restart_Mixing: 20
Solver_Lpole: 9
Full_Hartree: false

Minimization: manual
Movement_Num: 0
Skip_Force: true
Output_Level: 1
Output_All_States: false
