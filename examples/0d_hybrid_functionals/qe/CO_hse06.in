 &control
    calculation = 'scf'
    prefix = 'CO_hse06_L28_e150'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 1
    celldm(1) = 28.000000
    nat = 2
    ntyp = 2
    ecutwfc = 150.0
    assume_isolated = 'mt'
    nbnd = 9
    occupations = 'fixed'
    input_dft = 'hse'
    nqx1 = 1
    nqx2 = 1
    nqx3 = 1
    x_gamma_extrapolation = .false.
    exxdiv_treatment = 'gygi-baldereschi'
    ecutfock = 300.0
    screening_parameter = 0.11
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
ATOMIC_SPECIES
 C 12.011 c_pbe_tm.UPF
 O 15.999 o_pbe_tm.UPF
ATOMIC_POSITIONS bohr
 C 14.0000000000 14.0000000000 12.9339110068
 O 14.0000000000 14.0000000000 15.0660889932
K_POINTS gamma
