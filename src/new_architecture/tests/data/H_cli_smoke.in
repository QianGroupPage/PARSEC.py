Boundary_Conditions = cluster
Cluster_Domain_Shape sphere
Boundary_Sphere_Radius: 4.0 bohr
Grid_Spacing 0.8 bohr
Coordinate_Unit: Cartesian_Bohr
Expansion_Order: 4

States_Num: 3
Fermi_Temp: 80
Max_Iter: 1
Convergence_Criterion: 1.0d-4 Ry
Eigensolver: chebff
Subspace_Buffer_Size: 6
Mixing_Method: Anderson

Atom_Types_Num: 1
Atom_Type: H
Pseudopotential_Format: martins_new
Local_Component: s
Read_VCD: false
begin Atom_Coord
    0.0  0.0  0.0
end Atom_Coord

Correlation_Type: ca
