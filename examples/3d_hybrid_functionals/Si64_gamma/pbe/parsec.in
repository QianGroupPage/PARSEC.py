# 64-atom diamond Si (2x2x2 conventional cells, a = 10.26 bohr), Gamma point: real orbitals, the device Fock loop of the accelerated driver; timing case
# PBE (E_PBE of the comparison E_hyb - E_PBE)
# no Quantum ESPRESSO reference (timing case; one GPU)

Periodic_System: .true.
Boundary_Conditions: bulk
begin Cell_Shape
  20.5200000000 0.0 0.0
  0.0 20.5200000000 0.0
  0.0 0.0 20.5200000000
end Cell_Shape
Lattice_Vector_Scale: 1.0 bohr
Coordinate_Unit: Cartesian_Bohr
Grid_Spacing: 0.300
Expansion_Order: 12
Correlation_Type: pbe
States_Num: 140
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200
Fermi_Temp: 1 K
Atom_Types_Num: 1

Atom_Type: Si
Pseudopotential_Format: fhipp
Potential_Num: 3
Local_Component: d
Core_Cutoff_Radius: 2.1
begin Electron_Per_Orbital
2 2 0
end Electron_Per_Orbital
Cubic_Spline: .true.   # spline of the radial table, as in examples/0d_hybrid_functionals
