# Matched physical H2 benchmark for PARSEC and new_architecture.
#
# This uses PARSEC's canonical 863-point H_POTRE.DAT.  Double-grid order is
# explicitly one because the Python solver does not yet implement PARSEC's
# Ono-Hirose subgrid integration.  Both programs must use this exact input for
# an apples-to-apples comparison.

Restart_Run: .false.
Relax_Restart: .false.

Boundary_Conditions: cluster
Cluster_Domain_Shape: sphere
Boundary_Sphere_Radius: 7.0 ang
Grid_Spacing: 0.20 ang
Double_Grid_Order: 1
Coordinate_Unit: Cartesian_Ang

Expansion_Order: 8

States_Num: 16
Net_Charges: 0
Fermi_Temp: 500.0
Spin_Polarization: .false.
Max_Iter: 50
Convergence_Criterion: 2.0e-4
Diag_Tolerance: 1.0e-4

Eigensolver: chebff
Chebdav_Degree: 10
Chebyshev_Degree: 10
Chebyshev_Degree_Delta: 0

Mixing_Method: Anderson
Mixing_Param: 0.15

Atom_Types_Num: 1

Atom_Type: H
Pseudopotential_Format: martins_new
Local_Component: s
Read_VCD: .false.

begin Atom_Coord
   0.000000   0.000000  -0.375000
   0.000000   0.000000   0.375000
end Atom_Coord

Correlation_Type: ca
Electric_Field: 0.0

Output_All_States: .false.
Output_Level: 4
