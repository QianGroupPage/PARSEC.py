# h-BN monolayer (a = 4.73 bohr; B with core correction), slab of half height 15 bohr, Gamma-centred 6x6x1 mesh
# HSE06: 1/4 short-range exact exchange (erfc(0.11 r)/r) + PBE exchange - 1/4 short-range PBE exchange + PBE correlation
# Quantum ESPRESSO reference: qe/hbn_hse06_k661_e100_gb.in (ecutwfc 100 Ry)
# like-for-like with the QE row: its slab convention, q+G = 0 treatment and auxiliary exponent (Exx_* lines)

Periodic_System: .true.
Boundary_Conditions: slab
begin Cell_Shape
  4.7300000000 0.0000000000 0.0
  -2.3650000000 4.0963001599 0.0
end Cell_Shape
Boundary_Sphere_Radius: 15.00
Lattice_Vector_Scale: 1.0 bohr
Coordinate_Unit: Cartesian_Bohr
Grid_Spacing: 0.150
Expansion_Order: 12
Correlation_Type: hse06
Exx_Tolerance: 1e-8 Ry   # Fock-loop stop (default 1e-6 Ry), tight for the comparison
Exx_Slab_Coulomb: periodic   # QE's convention: the bulk kernel on the slab box itself (no padding)
Exx_Divergence: gygi-baldereschi   # q+G = 0 as the QE row (x_gamma_extrapolation = .false.)
Exx_Auxiliary_Exponent: 0.1000000   # QE's 10/ecutwfc in bohr^2 (default: the limit a -> 0)
States_Num: 8
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200
Fermi_Temp: 1 K
# the Gamma-centred 6x6x1 mesh of QE (K_POINTS automatic 6 6 1 0 0 0) written out:
# every point of the uniform mesh, equal weights (the exchange sums over all of them)
Kpoint_Method: manual
Kpoint_Unit: reciprocal_lattice_vectors
begin Kpoint_List
  0.000000000000 0.000000000000 0.000000000000
  0.000000000000 0.166666666667 0.000000000000
  0.000000000000 0.333333333333 0.000000000000
  0.000000000000 0.500000000000 0.000000000000
  0.000000000000 -0.333333333333 0.000000000000
  0.000000000000 -0.166666666667 0.000000000000
  0.166666666667 0.000000000000 0.000000000000
  0.166666666667 0.166666666667 0.000000000000
  0.166666666667 0.333333333333 0.000000000000
  0.166666666667 0.500000000000 0.000000000000
  0.166666666667 -0.333333333333 0.000000000000
  0.166666666667 -0.166666666667 0.000000000000
  0.333333333333 0.000000000000 0.000000000000
  0.333333333333 0.166666666667 0.000000000000
  0.333333333333 0.333333333333 0.000000000000
  0.333333333333 0.500000000000 0.000000000000
  0.333333333333 -0.333333333333 0.000000000000
  0.333333333333 -0.166666666667 0.000000000000
  0.500000000000 0.000000000000 0.000000000000
  0.500000000000 0.166666666667 0.000000000000
  0.500000000000 0.333333333333 0.000000000000
  0.500000000000 0.500000000000 0.000000000000
  0.500000000000 -0.333333333333 0.000000000000
  0.500000000000 -0.166666666667 0.000000000000
  -0.333333333333 0.000000000000 0.000000000000
  -0.333333333333 0.166666666667 0.000000000000
  -0.333333333333 0.333333333333 0.000000000000
  -0.333333333333 0.500000000000 0.000000000000
  -0.333333333333 -0.333333333333 0.000000000000
  -0.333333333333 -0.166666666667 0.000000000000
  -0.166666666667 0.000000000000 0.000000000000
  -0.166666666667 0.166666666667 0.000000000000
  -0.166666666667 0.333333333333 0.000000000000
  -0.166666666667 0.500000000000 0.000000000000
  -0.166666666667 -0.333333333333 0.000000000000
  -0.166666666667 -0.166666666667 0.000000000000
end Kpoint_List
Atom_Types_Num: 2

Atom_Type: B
Pseudopotential_Format: fhipp
Potential_Num: 3
Local_Component: d
Core_Cutoff_Radius: 1.8
begin Electron_Per_Orbital
2 1 0
end Electron_Per_Orbital
Cubic_Spline: .true.   # spline of the radial table, as in examples/0d_hybrid_functionals
Nonlinear_Core_Correction: .true.
begin Atom_Coord
     0.0000000000    0.0000000000    0.0000000000
end Atom_Coord

Atom_Type: N
Pseudopotential_Format: fhipp
Potential_Num: 3
Local_Component: d
Core_Cutoff_Radius: 1.6
begin Electron_Per_Orbital
2 3 0
end Electron_Per_Orbital
Cubic_Spline: .true.   # spline of the radial table, as in examples/0d_hybrid_functionals
begin Atom_Coord
     0.0000000000    2.7308667733    0.0000000000
end Atom_Coord
