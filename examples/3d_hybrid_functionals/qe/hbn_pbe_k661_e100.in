 &control
    calculation = 'scf'
    prefix = 'hbn_pbe_k661_e100'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 0
    nat = 2
    ntyp = 2
    ecutwfc = 100.0
    nbnd = 8
    occupations = 'fixed'
    input_dft = 'pbe'
    assume_isolated = '2D'
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
