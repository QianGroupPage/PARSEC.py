 &control
    calculation = 'scf'
    prefix = 'H2O_dist_r2scan_L20_e150'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
    tprnfor = .true.
 /
 &system
    ibrav = 1
    celldm(1) = 20.000000
    assume_isolated = 'mt'
    nat = 3
    ntyp = 2
    ecutwfc = 150.0
    ecutrho = 600.0
    nbnd = 8
    occupations = 'fixed'
    input_dft = 'XC-000I-000I-000I-000I-497L-498L'
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 300
 /
ATOMIC_SPECIES
 H 1.008 h_pbe_tm.UPF
 O 15.999 o_pbe_tm.UPF
ATOMIC_POSITIONS bohr
 O 9.8933006509 10.0000000000 9.3638357979
 H 11.5371281575 10.0000000000 10.6361642021
 H 8.4628718425 10.0000000000 10.4709928420
K_POINTS gamma
