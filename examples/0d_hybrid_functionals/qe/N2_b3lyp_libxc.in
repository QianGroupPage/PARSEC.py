 &control
    calculation = 'scf'
    prefix = 'N2_b3lyp_libxc_L24_e150'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 1
    celldm(1) = 24.000000
    nat = 2
    ntyp = 1
    ecutwfc = 150.0
    assume_isolated = 'mt'
    nbnd = 9
    occupations = 'fixed'
    input_dft = 'XC-000I-000I-402L-000I-000I-000I'
    nqx1 = 1
    nqx2 = 1
    nqx3 = 1
    x_gamma_extrapolation = .false.
    exxdiv_treatment = 'vcut_spherical'
    ecutfock = 300.0
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
