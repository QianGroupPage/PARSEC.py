 &control
    calculation = 'scf'
    prefix = 'O2_scan_L20_e300'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
    tprnfor = .true.
 /
 &system
    ibrav = 1
    celldm(1) = 20.000000
    assume_isolated = 'mt'
    nat = 2
    ntyp = 1
    ecutwfc = 300.0
    ecutrho = 1200.0
    nbnd = 11
    occupations = 'fixed'
    input_dft = 'XC-000I-000I-000I-000I-263L-267L'
    nspin = 2
    tot_magnetization = 2
 /
 &electrons
    conv_thr = 1.0d-09
    mixing_beta = 0.4
    electron_maxstep = 300
 /
ATOMIC_SPECIES
 O 15.999 o_pbe_tm.UPF
ATOMIC_POSITIONS bohr
 O 10.0000000000 10.0000000000 11.1409221477
 O 10.0000000000 10.0000000000 8.8590778523
K_POINTS gamma
