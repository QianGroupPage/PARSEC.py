# H2O (0.9572 A, 104.52 deg): PBE0: 1/4 exact exchange + 3/4 PBE exchange + PBE correlation
# Quantum ESPRESSO reference: input_dft = 'pbe0'

Boundary_Sphere_Radius: 11.53
Grid_Spacing: 0.160
Coordinate_Unit: Cartesian_Bohr
Expansion_Order: 12
Correlation_Type: pbe0
Exx_Tolerance: 1e-8 Ry   # Fock-loop stop (default 1e-6 Ry), tight for the comparison
States_Num: 8
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200
Atom_Types_Num: 2

