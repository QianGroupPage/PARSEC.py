Spin_Polarization: false
States_Num: 124
Net_Charges: 0 e
Fermi_Temp: 500 K
Max_Iter: 50
Convergence_Criterion: 2e-4 Ry

# PARSEC's Hartree boundary (multipoles up to Solver_Lpole = 9, no atomic tail), as in the
# Fortran run beside this input. Without this line the code chooses the multipole order for a
# boundary error of 1e-3 Ry, and the total energy of the larger clusters moves (C795H300: 3.2e-2 Ry).
Hartree_Boundary_Tolerance: off


Eigensolver: chebdav
Chebdav_Degree: 15
FF_MaxIter: 2
Matvec_Blocksize: 6
Chebyshev_Degree: 10
Chebyshev_Degree_Delta: 3
Subspace_Buffer_Size: 6
Diag_Tolerance: 1e-4

Mixing_Method: Anderson
Mixing_Param: 0.30
Memory_Param: 4
Restart_Mixing: 20
Solver_Lpole: 9
Full_Hartree: false

Initial_Density: sad
Normalize_Initial_Density: true

Skip_Force: true
Output_Level: 1
Output_All_States: false
