# Si, diamond structure, primitive fcc cell (a = 10.26 bohr), Gamma-centred 4x4x4 mesh
# PBE0: 1/4 exact exchange (1/r) + 3/4 PBE exchange + PBE correlation
# Quantum ESPRESSO reference: qe/si_pbe0_k444_e60_gbx.in (ecutwfc 60 Ry)
# Exx_Divergence auto (default): Gygi-Baldereschi with the x_gamma extrapolation on the 1/r kernel = QE's default

Periodic_System: .true.
Boundary_Conditions: bulk
begin Cell_Shape
  0.0000000000 5.1300000000 5.1300000000
  5.1300000000 0.0000000000 5.1300000000
  5.1300000000 5.1300000000 0.0000000000
end Cell_Shape
Lattice_Vector_Scale: 1.0 bohr
Coordinate_Unit: Cartesian_Bohr
Grid_Spacing: 0.250
Expansion_Order: 12
Correlation_Type: pbe0
Exx_Tolerance: 1e-8 Ry   # Fock-loop stop (default 1e-6 Ry), tight for the comparison
States_Num: 8
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200
Fermi_Temp: 1 K
# the Gamma-centred 4x4x4 mesh of QE (K_POINTS automatic 4 4 4 0 0 0) written out:
# every point of the uniform mesh, equal weights (the exchange sums over all of them)
Kpoint_Method: manual
Kpoint_Unit: reciprocal_lattice_vectors
