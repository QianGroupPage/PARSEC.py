 &control
    calculation = 'scf'
    prefix = 'o2_pbe_k111_e150_moved'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 0
    nat = 2
    ntyp = 1
    ecutwfc = 150.0
    nbnd = 11
    occupations = 'fixed'
    input_dft = 'pbe'
    nspin = 2
    tot_magnetization = 2
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
ATOMIC_SPECIES
 O 15.999 o_pbe_tm.UPF
