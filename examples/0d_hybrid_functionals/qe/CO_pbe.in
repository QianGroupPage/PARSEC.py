 &control
    calculation = 'scf'
    prefix = 'CO_pbe_L24_e150'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 1
    celldm(1) = 24.000000
    nat = 2
    ntyp = 2
    ecutwfc = 150.0
    assume_isolated = 'mt'
    nbnd = 9
    occupations = 'fixed'
    input_dft = 'pbe'
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
ATOMIC_SPECIES
 C 12.011 c_pbe_tm.UPF
 O 15.999 o_pbe_tm.UPF
ATOMIC_POSITIONS bohr
 C 12.0000000000 12.0000000000 10.9339110068
 O 12.0000000000 12.0000000000 13.0660889932
K_POINTS gamma
