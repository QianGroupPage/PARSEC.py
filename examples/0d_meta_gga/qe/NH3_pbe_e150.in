 &control
    calculation = 'scf'
    prefix = 'NH3_pbe_L20_e150'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
    tprnfor = .true.
 /
 &system
    ibrav = 1
    celldm(1) = 20.000000
    assume_isolated = 'mt'
    nat = 4
    ntyp = 2
    ecutwfc = 150.0
    ecutrho = 600.0
    nbnd = 8
    occupations = 'fixed'
    input_dft = 'pbe'
 /
 &electrons
    conv_thr = 1.0d-09
    mixing_beta = 0.4
    electron_maxstep = 300
 /
