 &control
    calculation = 'scf'
    prefix = 'CH4_tpss_L20_e150'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
    tprnfor = .true.
 /
 &system
    ibrav = 1
    celldm(1) = 20.000000
    assume_isolated = 'mt'
    nat = 5
    ntyp = 2
    ecutwfc = 150.0
    ecutrho = 600.0
    nbnd = 8
    occupations = 'fixed'
    input_dft = 'XC-000I-000I-000I-000I-202L-231L'
 /
 &electrons
    conv_thr = 1.0d-09
    mixing_beta = 0.4
    electron_maxstep = 300
 /
