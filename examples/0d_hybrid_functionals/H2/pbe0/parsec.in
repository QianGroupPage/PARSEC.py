# H2 (0.7414 A): PBE0: 1/4 exact exchange + 3/4 PBE exchange + PBE correlation
# Quantum ESPRESSO reference: input_dft = 'pbe0'

Boundary_Sphere_Radius: 10.70
Grid_Spacing: 0.160
Coordinate_Unit: Cartesian_Bohr
Expansion_Order: 12
Correlation_Type: pbe0
Exx_Tolerance: 1e-8 Ry   # Fock-loop stop (default 1e-6 Ry), tight for the comparison
States_Num: 5
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200
Atom_Types_Num: 1

Atom_Type: H
Pseudopotential_Format: fhipp
Potential_Num: 1
Local_Component: s
Core_Cutoff_Radius: 1.3
begin Electron_Per_Orbital
1
end Electron_Per_Orbital
Cubic_Spline: .true.   # spline of the radial table, see README
begin Atom_Coord
     0.0000000000    0.0000000000    0.7005214744
     0.0000000000    0.0000000000   -0.7005214744
end Atom_Coord
