# Si, diamond structure, primitive fcc cell (a = 10.26 bohr), Gamma-centred 2x2x2 mesh
# HSE06: 1/4 short-range exact exchange (erfc(0.11 r)/r) + PBE exchange - 1/4 short-range PBE exchange + PBE correlation
# Quantum ESPRESSO reference: qe/si_hse06_k222_e60_gb.in (ecutwfc 60 Ry)
# like-for-like with the QE row: its q+G = 0 treatment and auxiliary exponent (Exx_Divergence, Exx_Auxiliary_Exponent)

Periodic_System: .true.
Boundary_Conditions: bulk
begin Cell_Shape
  0.0000000000 5.1300000000 5.1300000000
  5.1300000000 0.0000000000 5.1300000000
  5.1300000000 5.1300000000 0.0000000000
end Cell_Shape
Lattice_Vector_Scale: 1.0 bohr
Coordinate_Unit: Cartesian_Bohr
Grid_Spacing: 0.250
Expansion_Order: 12
Correlation_Type: hse06
Exx_Tolerance: 1e-8 Ry   # Fock-loop stop (default 1e-6 Ry), tight for the comparison
Exx_Divergence: gygi-baldereschi   # q+G = 0 as the QE row (x_gamma_extrapolation = .false.)
Exx_Auxiliary_Exponent: 0.1666667   # QE's 10/ecutwfc in bohr^2 (default: the limit a -> 0)
States_Num: 8
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200
Fermi_Temp: 1 K
# the Gamma-centred 2x2x2 mesh of QE (K_POINTS automatic 2 2 2 0 0 0) written out:
# every point of the uniform mesh, equal weights (the exchange sums over all of them)
Kpoint_Method: manual
Kpoint_Unit: reciprocal_lattice_vectors
begin Kpoint_List
  0.000000000000 0.000000000000 0.000000000000
  0.000000000000 0.000000000000 0.500000000000
  0.000000000000 0.500000000000 0.000000000000
  0.000000000000 0.500000000000 0.500000000000
  0.500000000000 0.000000000000 0.000000000000
  0.500000000000 0.000000000000 0.500000000000
  0.500000000000 0.500000000000 0.000000000000
  0.500000000000 0.500000000000 0.500000000000
end Kpoint_List
Atom_Types_Num: 1

Atom_Type: Si
Pseudopotential_Format: fhipp
Potential_Num: 3
Local_Component: d
Core_Cutoff_Radius: 2.1
begin Electron_Per_Orbital
2 2 0
end Electron_Per_Orbital
Cubic_Spline: .true.   # spline of the radial table, as in examples/0d_hybrid_functionals
begin Atom_Coord
     0.0000000000    0.0000000000    0.0000000000
     2.5650000000    2.5650000000    2.5650000000
end Atom_Coord
