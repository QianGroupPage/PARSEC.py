 &control
    calculation = 'scf'
    prefix = 'hbn_hse06_k661_e160_gb_e160'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 0
    nat = 2
    ntyp = 2
    ecutwfc = 160.0
    nbnd = 8
    occupations = 'fixed'
    input_dft = 'hse'
    assume_isolated = '2D'
    nqx1 = 6
    nqx2 = 6
    nqx3 = 1
    x_gamma_extrapolation = .false.
    exxdiv_treatment = 'gygi-baldereschi'
    ecutfock = 320.0
    screening_parameter = 0.11
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
