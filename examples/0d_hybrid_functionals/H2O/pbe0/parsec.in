Pseudopotential_Format: fhipp
Potential_Num: 1
Local_Component: s
Core_Cutoff_Radius: 1.3
begin Electron_Per_Orbital
1
end Electron_Per_Orbital
Cubic_Spline: .true.   # spline of the radial table, see README
