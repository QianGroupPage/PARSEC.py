 &control
    calculation = 'scf'
    prefix = 'si_pbe_k222_e60_moved'
    outdir = './tmp'
    pseudo_dir = './pseudo'
    verbosity = 'high'
    disk_io = 'none'
 /
 &system
    ibrav = 0
    nat = 2
    ntyp = 1
    ecutwfc = 60.0
    nbnd = 8
    occupations = 'fixed'
    input_dft = 'pbe'
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
    electron_maxstep = 200
 /
ATOMIC_SPECIES
 Si 28.085 si_pbe_tm.UPF
CELL_PARAMETERS bohr
 0.0000000000 5.1300000000 5.1300000000
 5.1300000000 0.0000000000 5.1300000000
 5.1300000000 5.1300000000 0.0000000000
ATOMIC_POSITIONS bohr
 Si 0.0000000000 0.0356250000 0.0356250000
 Si 2.5650000000 2.6006250000 2.6006250000
K_POINTS automatic
 2 2 2 0 0 0
