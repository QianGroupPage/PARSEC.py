# CH4: TPSSh (Staroverov et al. 2003) of libxc: 10 % exact exchange + 90 % TPSS exchange + TPSS correlation
# Quantum ESPRESSO reference: input_dft = 'XC-000I-000I-000I-000I-000I-457L' (qe/README.md)

Boundary_Sphere_Radius: 12.05
Grid_Spacing: 0.160
Coordinate_Unit: Cartesian_Bohr
Expansion_Order: 12
LibXC_Functional: hyb_mgga_xc_tpssh   # libxc 457
Exx_Tolerance: 1e-8 Ry   # Fock-loop stop (default 1e-6 Ry), tight for the comparison
States_Num: 8
Convergence_Criterion: 1e-6 Ry
Diag_Tolerance: 1e-6
Max_Iter: 200

Atom_Types_Num: 2

Atom_Type: H
Pseudopotential_Format: fhipp
Potential_Num: 1
Local_Component: s
Core_Cutoff_Radius: 1.3
begin Electron_Per_Orbital
1
end Electron_Per_Orbital
Cubic_Spline: .true.
begin Atom_Coord
     1.1859538349    1.1859538349    1.1859538349
    -1.1859538349   -1.1859538349    1.1859538349
    -1.1859538349    1.1859538349   -1.1859538349
     1.1859538349   -1.1859538349   -1.1859538349
end Atom_Coord

Atom_Type: C
Pseudopotential_Format: fhipp
Potential_Num: 3
Local_Component: d
Core_Cutoff_Radius: 1.6
begin Electron_Per_Orbital
2 2 0
end Electron_Per_Orbital
Cubic_Spline: .true.
begin Atom_Coord
     0.0000000000    0.0000000000    0.0000000000
end Atom_Coord
